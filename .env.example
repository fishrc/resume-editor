# Copy to .env.local. This file contains examples, not real credentials.
DATABASE_URL=postgresql://db.example.com:5432/liveresume
PGUSER=liveresume_user
PGPASSWORD="replace-with-your-password"
# TLS verifies the server certificate. Use disable only for an intentional non-TLS connection.
PGSSLMODE=verify-full
# For a private certificate authority, set an absolute path to its PEM certificate:
# PGSSLROOTCERT=D:/certs/postgres-ca.pem
# Alternative to DATABASE_URL: PGHOST, PGPORT, PGDATABASE (+ PGUSER / PGPASSWORD).
# A namespace for this user's drafts and snapshots in a shared database.
RESUME_WORKSPACE=default
